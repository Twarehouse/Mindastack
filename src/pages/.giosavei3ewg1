import React, { useRef, useState, useEffect } from "react";
import ROSLIB from "roslib";

// SVG Icons
const IconPlay = () => (<svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor"><polygon points="5,3 19,12 5,21" /></svg>);
const IconPause = () => (<svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="4" width="4" height="16" /><rect x="14" y="4" width="4" height="16" /></svg>);
const IconResume = () => (<svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor"><polygon points="5,3 19,12 5,21" /></svg>);
const IconAbort = () => (<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5"><circle cx="12" cy="12" r="9" /><line x1="15" y1="9" x2="9" y2="15" /><line x1="9" y1="9" x2="15" y2="15" /></svg>);
const IconReset = () => (<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5"><polyline points="1 4 1 10 7 10" /><path d="M3.51 15a9 9 0 1 0 .49-3.5" /></svg>);
const IconUpload = () => (<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>);
const IconShield = () => (<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L3 7v6c0 5.25 3.75 10.15 9 11.25C17.25 23.15 21 18.25 21 13V7z"/></svg>);

export default function AMRControl() {
  const ros = useRef(null);
  const statusSub = useRef(null);
  const toastTimeoutRef = useRef(null);

  const [rosConfig, setRosConfig] = useState({ ip: "192.163.2.46", port: 9090 });
  const [connected, setConnected] = useState(false);
  const [state, setState] = useState("Disconnected");
  const [data, setData] = useState({ step: 0, total_steps: 0, mission_name: "None", safety_active: false });
  const [toast, setToast] = useState({ show: false, message: "", type: "info" });
  const [loading, setLoading] = useState(false);

  useEffect(() => {
    fetch("http://192.163.2.46:5000/api/config")
      .then(res => res.json())
      .then(config => setRosConfig(config))
      .catch(() => console.error("Config fetch failed"));
    return () => {
      if (toastTimeoutRef.current) clearTimeout(toastTimeoutRef.current);
    };
  }, []);

  useEffect(() => {
    connect();
    return () => { if (ros.current) ros.current.close(); };
  }, [rosConfig]);

  const connect = () => {
    if (ros.current) ros.current.close();
    const wsUrl = `ws://${rosConfig.ip}:${rosConfig.port || 9090}`;
    ros.current = new ROSLIB.Ros({ url: wsUrl });

    ros.current.on("connection", () => {
      setConnected(true);
      showToast("Connected to robot", "success");
      subscribeStatus();
    });
    ros.current.on("error", (err) => {
      console.error("ROS connection error:", err);
      setConnected(false);
    });
    ros.current.on("close", () => { setConnected(false); });
  };

  const subscribeStatus = () => {
    statusSub.current = new ROSLIB.Topic({
      ros: ros.current,
      name: "/mission/status",
      messageType: "std_msgs/String",
    });
    statusSub.current.subscribe((msg) => {
      try {
        const s = JSON.parse(msg.data);
        setState(s.state || "UNKNOWN");
        setData(s);
      } catch (e) { console.error("Telemetry Parse Error", e); }
    });
  };

  const callService = (name, successMessage = "Command sent") => {
    if (!connected) { showToast("System offline", "error"); return; }
    const svc = new ROSLIB.Service({ ros: ros.current, name, serviceType: "std_srvs/Trigger" });
    svc.callService({}, (res) => {
      if (res.success) showToast(res.message || successMessage, "success");
      else showToast(res.message || "Command failed", "error");
    });
  };

  const handleLoadMission = () => {
    if (!connected) { showToast("System offline - cannot load mission", "error"); return; }
    setLoading(true);
    callService("/mission/load", "Mission loaded successfully");
    setTimeout(() => setLoading(false), 1000);
  };

  const showToast = (message, type = "info") => {
    if (toastTimeoutRef.current) clearTimeout(toastTimeoutRef.current);
    setToast({ show: true, message, type });
    toastTimeoutRef.current = setTimeout(() => setToast({ show: false, message: "", type: "info" }), 3000);
  };

  const handlePauseResume = () => {
    if (state === "DRIVE_TO_TAG") callService("/mission/pause", "Mission paused");
    else if (state === "PAUSED") callService("/mission/resume", "Mission resumed");
  };

  const pct = data.total_steps > 0 ? ((data.step / data.total_steps) * 100).toFixed(1) : 0;
  const safetyActive = data.safety_active === true || data.safety_active === "true";

  const getToastColor = () => {
    switch (toast.type) {
      case "success": return "border-green-500 bg-green-900";
      case "error": return "border-red-500 bg-red-900";
      default: return "border-sky-500 bg-slate-900";
    }
  };

  return (
    <div className="min-h-screen p-6 lg:p-12 bg-gray-100 dark:bg-slate-950 text-gray-900 dark:text-white flex flex-col gap-8 font-sans transition-colors duration-500">

      {/* SAFETY ALERT BANNER */}
      {safetyActive && (
        <div className="fixed top-0 left-0 right-0 z-50 bg-red-600 text-white py-3 px-4 flex items-center justify-center gap-3 animate-pulse shadow-lg">
          <IconShield size={24} />
          <span className="font-black uppercase tracking-wider">⚠ SAFETY SYSTEM ACTIVE — ROBOT MOTION HALTED ⚠</span>
          <IconShield size={24} />
        </div>
      )}

      {/* HEADER SECTION */}
      <div className="flex justify-between items-end border-b-4 border-sky-500 pb-4">
        <div>
          <h1 className="text-5xl font-black tracking-tighter uppercase">Mission Control</h1>
          <p className="text-xl opacity-60 font-bold mt-2">ROS SYSTEM INTERFACE</p>
        </div>
        <div className="flex items-center gap-4">
          {/* SAFETY INDICATOR */}
          <div className="flex items-center gap-3 px-6 py-3 rounded-2xl bg-black/20 backdrop-blur-md border border-white/20">
            <span
              className="w-3 h-3 rounded-full flex-shrink-0 animate-pulse"
              style={{
                backgroundColor: safetyActive ? "#ef4444" : "#4ade80",
                boxShadow: safetyActive
                  ? "0 0 10px 2px rgba(239,68,68,0.8)"
                  : "0 0 8px 2px rgba(74,222,128,0.7)",
              }}
            />
            <IconShield size={18} className="text-white/80" />
            <span className="text-sm font-black uppercase tracking-wider">
              SAFETY: {safetyActive ? "ACTIVE" : "CLEAR"}
            </span>
          </div>

          {/* SYSTEM STATUS */}
          <div className={`px-8 py-3 rounded-2xl text-2xl font-black transition-all ${connected ? "bg-green-600 shadow-[0_0_20px_rgba(22,163,74,0.4)]" : "bg-red-600 animate-pulse"}`}>
            {connected ? "SYSTEM ONLINE" : "SYSTEM OFFLINE"}
          </div>
        </div>
      </div>

      {/* LOAD MISSION */}
      <div className="bg-white dark:bg-slate-900 rounded-[2.5rem] p-8 shadow-2xl border-2 dark:border-slate-800">
        <div className="flex flex-col items-center justify-center gap-6">
          <button
            onClick={handleLoadMission}
            disabled={!connected || loading}
            className="w-full md:w-96 px-12 py-8 bg-sky-600 hover:bg-sky-500 disabled:opacity-30 text-white rounded-[2rem] font-black uppercase text-2xl flex items-center justify-center gap-6 shadow-xl transition-all active:scale-95"
          >
            {loading ? <div className="animate-spin h-8 w-8 border-4 border-white border-t-transparent rounded-full" /> : <IconUpload />}
            {loading ? "Loading Mission..." : "Load Mission"}
          </button>
          <p className="text-sm opacity-50 text-center">Click to load the mission</p>
        </div>
      </div>

      {/* TELEMETRY DASHBOARD */}
      <div className="bg-white dark:bg-slate-900 rounded-[2.5rem] shadow-2xl p-10 border-2 dark:border-slate-800">
        <div className="flex justify-between items-center mb-10">
         